{
  "schema_version": 1,
  "coordinate_space": {
    "origin": "top_left",
    "units": "logical_pixels",
    "card_size": {
      "width": 160,
      "height": 145
    }
  },
  "sprite_fit_contract": {
    "source_region": "runtime_texture_alpha_bbox",
    "operation_order": [
      "trim_to_source_region",
      "aspect_preserving_contain_in_destination_rect"
    ],
    "fit_mode": "contain",
    "preserve_aspect": true
  },
  "base_card": {
    "implementation": "code_drawn_rounded_panel",
    "texture_tiles": [
      "res://games/grove/assets/ui/meadow_v2/texture_cream.png",
      "res://games/grove/assets/ui/meadow_v2/texture_meadow.png",
      "res://games/grove/assets/ui/meadow_v2/texture_supporting_purple.png",
      "res://games/grove/assets/ui/meadow_v2/texture_warm_kraft.png"
    ],
    "tintable": true,
    "baked_shadow": false
  },
  "portrait": {
    "rect": {
      "x": -8,
      "y": 10,
      "width": 110,
      "height": 144
    },
    "source_regions": {
      "giver_m2_1_clean_256.png": {
        "x": 50,
        "y": 9,
        "width": 155,
        "height": 238
      },
      "giver_m2_2_clean_256.png": {
        "x": 56,
        "y": 9,
        "width": 144,
        "height": 238
      },
      "giver_m2_3_clean_256.png": {
        "x": 40,
        "y": 9,
        "width": 176,
        "height": 238
      }
    },
    "fit_alignment": "bottom_center",
    "anchor": "bottom_center",
    "preserve_aspect": true,
    "clip_to_card": false,
    "bottom_overflow": 9,
    "shadow": "runtime_shared_shallow"
  },
  "request_note": {
    "asset": "final/quest_request_note_256x288.png",
    "source_region": {
      "x": 29,
      "y": 12,
      "width": 198,
      "height": 263
    },
    "rect": {
      "x": 97,
      "y": 8,
      "width": 61,
      "height": 69
    },
    "pivot": {
      "x": 0.5,
      "y": 0.5
    },
    "fit_alignment": "center",
    "preserve_aspect": true,
    "rotation_degrees": {
      "min": -3,
      "max": 3,
      "seed": "stable_quest_id"
    },
    "item_safe_rect": {
      "x": 106,
      "y": 18,
      "width": 44,
      "height": 48
    },
    "shadow": "runtime_shared_shallow"
  },
  "reward_tag": {
    "asset": "final/quest_reward_seed_tag_256.png",
    "source_region": {
      "x": 39,
      "y": 11,
      "width": 177,
      "height": 234
    },
    "rect": {
      "x": 100,
      "y": 81,
      "width": 59,
      "height": 63
    },
    "pivot": {
      "x": 0.5,
      "y": 0.5
    },
    "fit_alignment": "center",
    "preserve_aspect": true,
    "safe_region_contract": {
      "mask": "rendered_reward_tag_alpha",
      "opaque_threshold": 128,
      "rule": "Every point in content_safe_rect and value_box, and every point in the inscribed ellipse of coin_box, must land on alpha >= opaque_threshold after trim and fit."
    },
    "content_safe_rect": {
      "x": 111,
      "y": 110,
      "width": 38,
      "height": 18
    },
    "coin_box": {
      "x": 111,
      "y": 110,
      "width": 18,
      "height": 18
    },
    "value_box": {
      "x": 129,
      "y": 110,
      "width": 20,
      "height": 18
    },
    "shadow": "runtime_alpha_silhouette_shallow"
  },
  "dynamic_content": {
    "requested_item": "PieceView.make_piece(...) inside request_note.item_safe_rect",
    "reward_coin": "res://games/grove/assets/ui/meadow_v2/coin.png",
    "reward_text": "code_drawn_plus_value",
    "ready_overlay": "existing dynamic ready check",
    "card_tint": "runtime quest family tint",
    "note_rotation": "runtime stable quest id"
  },
  "layer_order": [
    "card_shadow",
    "base_card",
    "portrait",
    "request_note_shadow",
    "request_note",
    "requested_item",
    "reward_tag_shadow",
    "reward_tag",
    "reward_coin",
    "reward_text",
    "ready_overlay"
  ]
}
