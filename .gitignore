# Build / export artifacts — regenerated by `godot --export`
# (see docs/design/apple-services-setup.md and docs/design/keeping-the-build-small.md)
build/
!build/
build/*
!build/ios/
build/ios/*
!build/ios/ci_scripts/
!build/ios/ci_scripts/ci_post_clone.sh

# Safety net: never commit large export outputs even if exported outside build/
*.pck
*.xcframework/

# iOS Apple-services plugin (Game Center + StoreKit) — large prebuilt binaries,
# fetched per-checkout by `make ios-plugins` (tools/install_ios_plugins.sh).
# Regenerable like the baked caches, so the whole dir is ignored; the script is
# the source of truth (pinned release).
/addons/

# Godot editor cache & reimported binaries (the bare form also ignores a
# worktree `.godot` symlink, which `.godot/` would not match)
.godot/
.godot

# macOS
.DS_Store

# Python bytecode cache (tools/)
__pycache__/
*.pyc

# Local scratch / transient overrides
/tmp/
/.scratch/
override.cfg
/archive/

# Generated per-export runtime constants (for example, player-visible iOS build info)
/engine/generated/

# Grove art import-skip toggle: a LOCAL build-speed switch, not source. Nothing in the
# repo creates it — drop it in by hand to boot without importing grove art; `make g` and
# `make debug` delete it so the grove art imports + loads. Either way: never committed.
games/grove/assets/.gdignore

# Brainstorm visual companion scratch
.superpowers/

# Local feature worktrees
.worktrees/

# Review captures (agent screenshots) — never shipped, and .gdignore keeps them out of the import pass
_shots/
